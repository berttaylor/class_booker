# Teacher Sync Login
TEACHER_SYNC_LOGIN_EMAIL=YOUR_EMAIL
TEACHER_SYNC_LOGIN_PASSWORD=YOUR_PASSWORD

# Pushover notifications (optional — leave blank to disable)
PUSHOVER_USER_KEY=YOUR_PUSHOVER_USER_KEY
PUSHOVER_API_TOKEN=YOUR_PUSHOVER_API_TOKEN

# Healthchecks.io dead-man's switch (optional — leave blank to disable).
# The crontab pings this after every successful run-due; if pings stop
# arriving, Healthchecks alerts you. This catches the box being dead, which
# Pushover cannot (a dead container sends nothing).
HC_PING_URL=

# Login for the web UI (checked by web.py — Caddy only handles TLS).
# Required in production — the app refuses to start without them, because a
# missing hash would mean no one (or, worse, silently everyone) can log in.
#
# Both users get identical access; separate accounts exist so one can be rotated
# or revoked independently, and so who's logged in is recorded in the session.
#
# Generate with:
#   make hash
# `make hash` already escapes it for you. Written by hand instead? DOUBLE
# every "$": compose interpolates every value in .env (not just ones read via
# `environment:`), and a single "$" gets silently swallowed, corrupting the
# hash. $2b$... becomes $$2b$$...
AUTH_HASH_ADMIN=
AUTH_HASH_LEIGH=

# Signs the login session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
