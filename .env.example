# Teacher Sync Login
TEACHER_SYNC_LOGIN_EMAIL=YOUR_EMAIL
TEACHER_SYNC_LOGIN_PASSWORD=YOUR_PASSWORD

# Pushover notifications (optional — leave blank to disable)
PUSHOVER_USER_KEY=YOUR_PUSHOVER_USER_KEY
PUSHOVER_API_TOKEN=YOUR_PUSHOVER_API_TOKEN

# Healthchecks.io dead-man's switch (optional — leave blank to disable).
# The crontab pings this after every successful run-due; if pings stop
# arriving, Healthchecks alerts you. This catches the box being dead, which
# Pushover cannot (a dead container sends nothing).
HC_PING_URL=

# Caddy Basic Auth hashes for the web UI (used by compose.yml -> Caddyfile).
# Required in production — Caddy refuses to start without them, because an empty
# hash would serve the schedules (including booking passwords) unauthenticated.
#
# Both users get identical access; separate accounts exist so one can be rotated
# or revoked independently, and so the access log shows which login was used.
#
# Generate and escape in one step (handles the $$ requirement below):
#   make hash
#
# Or manually:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
# then DOUBLE every "$" before pasting: compose reads a single "$" as variable
# interpolation and silently eats part of the hash, which breaks login.
# So $2a$14$abc... is stored here as $$2a$$14$$abc...
BASIC_AUTH_HASH_ADMIN=
BASIC_AUTH_HASH_LEIGH=
