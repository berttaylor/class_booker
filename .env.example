# Teacher Sync Login
TEACHER_SYNC_LOGIN_EMAIL=YOUR_EMAIL
TEACHER_SYNC_LOGIN_PASSWORD=YOUR_PASSWORD

# Pushover notifications (optional — leave blank to disable)
PUSHOVER_USER_KEY=YOUR_PUSHOVER_USER_KEY
PUSHOVER_API_TOKEN=YOUR_PUSHOVER_API_TOKEN

# Healthchecks.io dead-man's switch (optional — leave blank to disable).
# The crontab pings this after every successful run-due; if pings stop
# arriving, Healthchecks alerts you. This catches the box being dead, which
# Pushover cannot (a dead container sends nothing).
HC_PING_URL=
