# Build context hygiene: keep secrets and host-specific state out of the image.
.git
.gitignore
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.idea
.jbeval
.claude
.DS_Store

# Secrets and runtime state — mounted as volumes at run time, never baked in.
.env
logs/
data/
cache/
scheduling_rules/*.yml
.run_due.lock

# macOS launchd leftovers, replaced by crontab + supercronic.
runners/
setup.sh

# Not needed at runtime.
tests/
pytest.ini
.pre-commit-config.yaml
.github/
README.md
CLAUDE.md
