# Local development. NOT auto-loaded — compose only reads compose.override.yml
# by name, and this is deliberately named differently so a server can never
# pick it up from a git pull. Opt in explicitly (or just use `make up`):
#
#   docker compose -f compose.yml -f compose.dev.yml up -d
#
#   docker compose -f compose.yml -f compose.dev.yml run --rm cron \
#       python main.py run-due --force-soft
#
# Locally the web service is published on loopback and reached directly, with
# no Caddy in front. That is safe because Flask enforces the login itself (see
# app/webauth.py) — the published port leads to the same login page production
# serves, not past it. Caddy stays parked below: with auth out of it, all it
# adds locally is TLS that a laptop cannot get anyway.
services:
  web:
    ports:
      # Loopback only, so the laptop does not serve this to the LAN.
      - "127.0.0.1:8008:8008"

  # Opt-in only, both of them:
  #   caddy — would try (and fail) to get a certificate for the real domain,
  #           and would grab ports 80/443 on the laptop.
  #   cron  — `docker compose up` must not start booking real classes from a
  #           development machine. Use `docker compose run --rm cron ...`.
  caddy:
    profiles:
      - manual

  cron:
    profiles:
      - manual
